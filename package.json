{
  "name": "iobroker.opendtu",
  "version": "1.1.1",
  "description": "Adapter for the OpenDTU project",
  "author": {
    "name": "Dennis Rathjen",
    "email": "dennis.rathjen@outlook.de"
  },
  "contributors": [
    {
      "name": "Marcus Bortel",
      "url": "https://github.com/Creekhail"
    }
  ],
  "homepage": "https://github.com/Creekhail/ioBroker.opendtu",
  "license": "MIT",
  "keywords": [
    "OpenDTU",
    "Solar"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Creekhail/ioBroker.opendtu.git"
  },
  "engines": {
    "node": ">= 20"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.1",
    "axios": "^1.18.1",
    "node-schedule": "^2.1.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.0",
    "@alcalzone/release-script-plugin-manual-review": "^5.2.0",
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^5.3.0",
    "@tsconfig/node20": "^20.1.9",
    "@types/chai": "^5.2.3",
    "@types/chai-as-promised": "^8.0.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1.1",
    "@types/proxyquire": "^1.3.31",
    "@types/sinon": "^22.0.0",
    "@types/sinon-chai": "^4.0.0",
    "chai": "^6.2.2",
    "chai-as-promised": "^8.0.2",
    "mocha": "^12.0.2",
    "proxyquire": "^2.1.3",
    "sinon": "^22.0.0",
    "sinon-chai": "^4.0.1",
    "typescript": "~6.0.3"
  },
  "main": "main.js",
  "files": [
    "admin{,/!(src)/**}/!(tsconfig|tsconfig.*|.eslintrc).json",
    "admin{,/!(src)/**}/*.{html,css,png,svg,jpg,js}",
    "lib/",
    "www/",
    "io-package.json",
    "LICENSE",
    "main.js"
  ],
  "scripts": {
    "test:js": "mocha --config test/mocharc.custom.json \"{!(node_modules|test)/**/*.test.js,*.test.js,test/**/test!(PackageFiles|Startup).js}\"",
    "test:package": "mocha test/package --exit",
    "test:integration": "mocha test/integration --exit",
    "test": "npm run test:js && npm run test:package",
    "check": "tsc --noEmit -p tsconfig.check.json",
    "lint": "eslint -c eslint.config.mjs .",
    "translate": "translate-adapter",
    "release": "release-script"
  },
  "bugs": {
    "url": "https://github.com/Creekhail/ioBroker.opendtu/issues"
  },
  "readmeFilename": "README.md"
}
